{
  "expo": {
    "name": "Jorgo — Электровелосипед",
    "slug": "jorgo-client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kg.jorgo.client",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "kg.jorgo.client"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "lang": "ky",
      "themeColor": "#2E7D32",
      "description": "Электровелосипеддер, запчасттар жана оңдоо"
    },
    "scheme": "jorgo",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#2E7D32"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Паспорт, селфи, төлөмдүн скриншоту жана оңдолчу велосипеддин сүрөтүн жүктөө үчүн галереяга уруксат керек.",
          "cameraPermission": "Ижарага каттоодо селфи жана паспорттун сүрөтүн тартуу үчүн камерага уруксат керек.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Мастер выездге так келиши жана ижара өтүнмөсүнө дарек кошуу үчүн жайгашкан жериңиз керек. Колдонмо колдонулуп жатканда гана алынат.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
